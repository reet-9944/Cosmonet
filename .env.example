# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/cosmonet

# JWT Secret (change this in production!)
JWT_SECRET=your-secret-key-change-in-production

# Email Configuration (Optional - only needed if you want email notifications)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password-here
ADMIN_EMAIL=your-email@gmail.com

# Server Port
PORT=4000

# Instructions:
# 1. Copy this file to .env
# 2. Replace the values with your actual credentials
# 3. For Gmail, you need to:
#    - Enable 2-factor authentication
#    - Generate an "App Password" from Google Account settings
#    - Use that app password in EMAIL_PASS
